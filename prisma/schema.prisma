// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Jersey {
  id           String        @id // Peut être égal à l'ID "physique" inscrit dans la puce (ex: UUID, ou "jersey-1")
  name         String        // Nom ou description (ex: "Maillot Mbappé Home 2024")
  createdAt    DateTime      @default(now())
  scans        Scan[]
  participations Participation[]
  jerseyDexEntries JerseyDex[]
}

model Scan {
  id        String   @id @default(cuid())
  walletAddress String  // Adresse wallet du scanner
  jersey    Jersey   @relation(fields: [jerseyId], references: [id])
  jerseyId  String
  scannedAt DateTime @default(now())
}

model Contest {
  id          String        @id @default(cuid())
  name        String        // Nom du concours (ex: "Concours But Mbappé")
  description String?       // Description optionnelle
  startedAt   DateTime      // Heure de début du concours
  endedAt     DateTime?     // Heure de fin du concours (choisie par l'admin)
  firstPrize  String        // Prix du 1er gagnant (ex: "1000 CHZ + Maillot Collector")
  secondPrize String        // Prix du 2ème gagnant (ex: "500 CHZ + Maillot")
  thirdPrize  String        // Prix du 3ème gagnant (ex: "250 CHZ")
  maxWinners  Int          @default(3) // Nombre de gagnants (fixé à 3)
  status      ContestStatus @default(ACTIVE) // Statut du concours
  participations Participation[]
  winners     Winner[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Champs blockchain
  blockchainEnabled Boolean @default(true) // Intégration blockchain activée
  blockchainNetwork String @default("testnet") // testnet ou mainnet
  blockchainEvents Json? // Historique des événements blockchain
}

model Participation {
  id          String   @id @default(cuid())
  contest     Contest  @relation(fields: [contestId], references: [id])
  contestId   String
  jersey      Jersey   @relation(fields: [jerseyId], references: [id])
  jerseyId    String
  walletAddress String  // Adresse wallet du participant
  username    String?  // Nom d'utilisateur du participant
  participatedAt DateTime @default(now())
  
  // Champs blockchain
  blockchainTxHash String? // Hash de la transaction blockchain
  blockchainTimestamp DateTime? // Timestamp blockchain
  blockchainConfirmed Boolean @default(false) // Transaction confirmée on-chain
  blockchainData Json? // Données additionnelles de la blockchain
  
  @@unique([contestId, walletAddress, jerseyId], name: "contest_wallet_jersey_unique")
}

model Winner {
  id        String   @id @default(cuid())
  contest   Contest  @relation(fields: [contestId], references: [id])
  contestId String
  walletAddress String  // Adresse wallet du gagnant
  prize     String   // Description du prix gagné (ex: "10 $PSG Fan Tokens")
  wonAt     DateTime @default(now())
  
  // Champs blockchain
  blockchainTxHash String? // Hash de la transaction d'annonce
  blockchainTimestamp DateTime? // Timestamp blockchain
  blockchainConfirmed Boolean @default(false) // Annonce confirmée on-chain
  blockchainData Json? // Données de l'annonce blockchain
}

model JerseyDex {
  id            String   @id @default(cuid())
  walletAddress String
  jersey        Jersey   @relation(fields: [jerseyId], references: [id])
  jerseyId      String
  addedAt       DateTime @default(now())

  @@unique([walletAddress, jerseyId], name: "wallet_jersey_unique")
}

enum ContestStatus {
  ACTIVE    // Concours en cours
  FINISHED  // Concours terminé
  CANCELLED // Concours annulé
}
